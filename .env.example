# ==============================================================================
# Idea-Tracer AI 설정 파일 (.env)
# ==============================================================================
# API 키는 본 파일(.env)에서 직접 설정 및 관리합니다.
# Gemini API Key 발급: https://aistudio.google.com/
# OpenAI API Key 발급: https://platform.openai.com/
# ==============================================================================

# 1. 사용할 AI 제공자 ('gemini' 또는 'openai')
AI_PROVIDER=gemini

# 2. Google Gemini API 키
GEMINI_API_KEY=

# 3. Google Gemini 모델명 (gemini-3.6-flash, gemini-2.0-flash, gemini-1.5-flash 등)
GEMINI_MODEL=gemini-3.6-flash

# 4. OpenAI API 키 (선택사항)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
